# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
*.tfplan
override.tf
override.tf.json
*_override.tf
.terraform.lock.hcl.bak

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/
build/
dist/

# Go
*.test
/bin/
coverage.out

# Build artifacts
**/.build/
*.zip

# Editors / OS
.idea/
.vscode/
.DS_Store

# Secrets — never commit these
*.pem
.env

# Lock files here were generated from a single-platform mirror. In your own fork,
# run `terraform providers lock -platform=linux_amd64 -platform=darwin_arm64` and commit them.
.terraform.lock.hcl
